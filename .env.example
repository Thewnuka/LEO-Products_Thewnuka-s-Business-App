# ===========================================================================
# LEO PRODUCTS — environment variables
# Copy this file to `.env` and fill in real values:
#     Copy-Item .env.example .env
# NEVER commit the .env file. It is listed in .gitignore.
# ===========================================================================

# --- Django core -----------------------------------------------------------
# Generate a new key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-long-random-secret-key

# True only on your own computer. Production settings force this to False.
DEBUG=True

# Comma-separated host names allowed to serve the site.
ALLOWED_HOSTS=localhost,127.0.0.1

# Full origins (with https://) allowed to submit forms, needed in production.
# Example: https://leoproducts.example,https://www.leoproducts.example
CSRF_TRUSTED_ORIGINS=

# Which settings file to use. Leave commented locally (manage.py uses development).
# DJANGO_SETTINGS_MODULE=config.settings.production

# Path of the admin site (change it in production to something less obvious).
ADMIN_URL=admin/

TIME_ZONE=Asia/Colombo

# --- Database --------------------------------------------------------------
# Leave empty for local SQLite (db.sqlite3 in the project folder).
# Production PostgreSQL example:
#   DATABASE_URL=postgres://leo_user:strong-password@localhost:5432/leo_products
DATABASE_URL=

# --- Initial OWNER account (used once by `python manage.py bootstrap_owner`) -
# Leave these EMPTY in this file. Prefer typing them only in your terminal
# session (see DEVELOPMENT_GUIDE.md) or let the command ask you interactively.
# If you put them in .env, delete OWNER_PASSWORD again after the first run.
OWNER_USERNAME=
OWNER_EMAIL=
OWNER_PASSWORD=

# --- Sign-in protection ----------------------------------------------------
# After this many failed sign-ins (same name + same IP), wait this many seconds.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW=900

# --- Online payment gateway (optional) --------------------------------------
# Leave PAYMENT_GATEWAY empty to switch online payment off. Supported: payhere
# Get these from your PayHere merchant account (use sandbox details for testing).
# NEVER commit real values.
#   1. Create a sandbox account at https://sandbox.payhere.lk and add your site's domain
#      (Integrations → Add domain/app); PayHere then shows the Merchant ID and a
#      Merchant Secret for that domain.
#   2. PayHere must be able to reach https://<your-domain>/payments/webhook/payhere/
#      from the internet: payments are only marked paid after that verified call.
#      (A local server is not reachable; use the real server or a tunnel when testing.)
#   3. Pay a test order with PayHere's sandbox test cards, then set PAYHERE_SANDBOX=False
#      and use your live Merchant ID/Secret only after that works.
PAYMENT_GATEWAY=
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=True

# --- Email -------------------------------------------------------------------
# Development prints emails (e.g. password reset links) in the terminal.
# Configure a real SMTP server before going live.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=LEO PRODUCTS <no-reply@localhost>

# --- Production HTTPS (used by config.settings.production only) ------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# Set True when running behind a proxy/host that terminates HTTPS.
USE_X_FORWARDED_PROTO=False
