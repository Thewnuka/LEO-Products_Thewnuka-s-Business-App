# ===========================================================================
# LEO PRODUCTS — production environment (EXAMPLE ONLY: no real values here)
# Copy to the server as `.env` in the project folder, fill in every value,
# and make the file readable only by the account that runs the app.
# NEVER commit the real file.
# ===========================================================================
DJANGO_SETTINGS_MODULE=config.settings.production

# A NEW long random key (do not reuse the development key):
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Your real domain name(s), comma-separated, e.g. shop.example.lk,www.shop.example.lk
ALLOWED_HOSTS=
# The same domain(s) with https://, e.g. https://shop.example.lk,https://www.shop.example.lk
CSRF_TRUSTED_ORIGINS=

# PostgreSQL: postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# A hard-to-guess admin path (letters, numbers, dashes), ending with /
ADMIN_URL=

# Folders outside the web root (absolute paths). Back both up together with the database.
PRIVATE_MEDIA_ROOT=
# MEDIA files (product photos) live in the project's media/ folder unless you change MEDIA_ROOT in settings.

# HTTPS. Behind Nginx/a hosting platform that terminates HTTPS, set USE_X_FORWARDED_PROTO=True.
SECURE_SSL_REDIRECT=True
USE_X_FORWARDED_PROTO=True
# Start low; raise to 31536000 (one year) once HTTPS works everywhere.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# Single Windows PC without Nginx: let Django serve product photos.
SERVE_MEDIA=False

# Email (order emails, password resets): your SMTP provider's details
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# Online payment: leave PAYMENT_GATEWAY empty until PayHere is set up and tested (see DEVELOPMENT_GUIDE §10)
PAYMENT_GATEWAY=
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=True

LOG_LEVEL=WARNING
