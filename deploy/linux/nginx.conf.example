# /etc/nginx/sites-available/leo-products  (EXAMPLE: replace YOUR-DOMAIN and paths)
# HTTPS certificates: e.g. `sudo certbot --nginx -d YOUR-DOMAIN`
server {
    listen 80;
    server_name YOUR-DOMAIN;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name YOUR-DOMAIN;
    # ssl_certificate / ssl_certificate_key: added by certbot

    client_max_body_size 6m;   # uploads are limited to 5 MB by the app

    # Public product photos only. PRIVATE_MEDIA_ROOT (payment slips, receipts) must NOT be listed here.
    location /media/ {
        alias /srv/leo-products/media/;
        add_header X-Content-Type-Options nosniff;
        expires 7d;
    }

    # Static files are served by the app (WhiteNoise); proxy everything to Gunicorn.
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
