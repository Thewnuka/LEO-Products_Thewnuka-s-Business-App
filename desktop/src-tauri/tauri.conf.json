{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LEO PRODUCTS",
  "version": "1.0.0",
  "identifier": "com.leoproducts.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LEO PRODUCTS",
        "url": "http://127.0.0.1:8000/staff/login/",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "maximized": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "LEO PRODUCTS",
    "shortDescription": "LEO PRODUCTS business management and point of sale",
    "longDescription": "Desktop window for the LEO PRODUCTS web application. Requires the LEO PRODUCTS server to be running and reachable.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
